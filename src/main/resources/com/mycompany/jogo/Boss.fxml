<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.jogo.controller.BossController"
      styleClass="tela-fundo"
      spacing="0"
      prefWidth="800" prefHeight="600">

    <VBox styleClass="hud-painel" spacing="6" alignment="CENTER">
        <padding><Insets top="10" bottom="10"/></padding>
        <Label text="✝  O SACERDOTE DO SINO  ✝" styleClass="label-boss"/>
        <HBox spacing="8" alignment="CENTER">
            <Label text="VIDA DO BOSS:" styleClass="label-info"/>
            <ProgressBar fx:id="barraBoss" progress="1.0"
                         styleClass="barra-vida" prefWidth="400" prefHeight="14"/>
            <Label fx:id="labelVidaBoss" text="500/500" styleClass="label-sangue"/>
        </HBox>
    </VBox>

    <HBox styleClass="hud-painel" spacing="24" alignment="CENTER_LEFT">
        <VBox spacing="2" minWidth="160">
            <Label fx:id="labelVida" text="❤ 100/100" styleClass="label-sangue"/>
            <ProgressBar fx:id="barraVida" progress="1.0"
                         styleClass="barra-vida" prefWidth="160" prefHeight="8"/>
        </VBox>
        <VBox spacing="2" minWidth="160">
            <Label fx:id="labelVigor" text="◈ 100/100" styleClass="label-xp"/>
            <ProgressBar fx:id="barraVigor" progress="1.0"
                         styleClass="barra-vigor" prefWidth="160" prefHeight="8"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="labelSangue" text="🩸 0" styleClass="label-sangue"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <!-- Canvas: fundo, grade, aura do boss, efeitos atmosféricos -->
        <Canvas fx:id="canvasBoss" width="800" height="440" styleClass="arena-gameplay"/>

        <!-- Pane transparente para os sprites PNG (jogador, boss, projétil) -->
        <Pane fx:id="spritePane" mouseTransparent="true" prefWidth="800" prefHeight="440"/>

        <!-- Overlay de resultado -->
        <VBox fx:id="painelResultado" alignment="CENTER" spacing="16"
              visible="false" styleClass="tela-fundo">
            <Label fx:id="labelResultado" text="" styleClass="label-boss"/>
            <Label fx:id="labelResultadoDesc" text="" styleClass="label-info" wrapText="true"
                   textAlignment="CENTER" maxWidth="500"/>
            <Button fx:id="btnResultado" text="Continuar" styleClass="btn-menu"
                    onAction="#onContinuarAposResultado"/>
        </VBox>
    </StackPane>

    <HBox styleClass="hud-painel" spacing="30" alignment="CENTER">
        <Label text="WASD — Mover" styleClass="label-info"/>
        <Label text="J — Atacar" styleClass="label-info"/>
        <Label text="K — Esquivar" styleClass="label-info"/>
    </HBox>

</VBox>