<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.jogo.controller.CreditosController"
      styleClass="tela-fundo"
      alignment="CENTER"
      spacing="18"
      prefWidth="800" prefHeight="600">

    <padding><Insets top="50" bottom="50" left="100" right="100"/></padding>

    <Label text="SINO DE VESPER" styleClass="titulo-jogo"/>
    <Label text="— Créditos —" styleClass="subtitulo"/>

    <Region minHeight="20"/>

    <Label text="Desenvolvido por" styleClass="label-info"/>
    <Label fx:id="labelDupla" text="Lucas Lopes &amp; Guilherme Rotela" styleClass="creditos-destaque"/>

    <Region minHeight="10"/>

    <Button text="← Voltar" styleClass="btn-voltar" onAction="#onVoltar"/>

</VBox>
