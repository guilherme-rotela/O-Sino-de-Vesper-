<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.jogo.controller.RankingController"
      styleClass="tela-fundo"
      spacing="16"
      prefWidth="1920" prefHeight="1080">

    <padding><Insets top="40" bottom="40" left="80" right="80"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="RANKING DE CAÇADORES" styleClass="label-titulo-tela"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⬇ Exportar CSV" styleClass="btn-acao" onAction="#onExportar"/>
    </HBox>

    <Label text="Os mais corajosos que ousaram entrar em Vesper." styleClass="label-info"/>

    <TableView fx:id="tabelaRanking" styleClass="tabela-ranking" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPos"      text="#"        prefWidth="50"/>
            <TableColumn fx:id="colNome"     text="Caçador"  prefWidth="200"/>
            <TableColumn fx:id="colNivel"    text="Nível"    prefWidth="80"/>
            <TableColumn fx:id="colXp"       text="XP Total" prefWidth="120"/>
            <TableColumn fx:id="colSangue"   text="Sangue"   prefWidth="120"/>
            <TableColumn fx:id="colPartidas" text="Partidas" prefWidth="100"/>
            <TableColumn fx:id="colInimigos" text="Inimigos" prefWidth="110"/>
            <TableColumn fx:id="colVitorias" text="Vitórias" prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="Nenhum caçador registrado ainda." styleClass="label-info"/>
        </placeholder>
    </TableView>

    <Label fx:id="labelExportFeedback" text="" styleClass="label-xp" visible="false"/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="← Voltar ao Menu" styleClass="btn-voltar" onAction="#onVoltar"/>
    </HBox>

</VBox>