CREATE TABLE jogadores (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(50) NOT NULL UNIQUE,
    criado_em TIMESTAMP DEFAULT NOW()
);
 
CREATE TABLE upgrades (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(50) NOT NULL,
    descricao TEXT,
    tipo VARCHAR(20) NOT NULL, 
    custo_sangue INT NOT NULL,
    bonus_valor INT NOT NULL
);
 
CREATE TABLE jogador_upgrades (
    id SERIAL PRIMARY KEY,
    jogador_id INT REFERENCES jogadores(id) ON DELETE CASCADE,
    upgrade_id INT REFERENCES upgrades(id),
    quantidade INT DEFAULT 1,
    UNIQUE(jogador_id, upgrade_id)
);

CREATE TABLE jogador_atributos (
    id SERIAL PRIMARY KEY,
    jogador_id INT REFERENCES jogadores(id) ON DELETE CASCADE UNIQUE,
    vitalidade INT DEFAULT 10,
    vigor INT DEFAULT 10,
    tecnica INT DEFAULT 10,
    pontos_sangue INT DEFAULT 0,
    total_xp INT DEFAULT 0,
    nivel INT DEFAULT 1
);
 
CREATE TABLE itens_loja (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(50) NOT NULL,
    descricao TEXT,
    tipo VARCHAR(20) NOT NULL,
    custo_sangue INT NOT NULL,
    bonus_atributo VARCHAR(20),
    bonus_valor INT DEFAULT 0
);
 
CREATE TABLE inventario (
    id SERIAL PRIMARY KEY,
    jogador_id INT REFERENCES jogadores(id) ON DELETE CASCADE,
    item_id INT REFERENCES itens_loja(id),
    quantidade INT DEFAULT 1
);
 
CREATE TABLE partidas (
    id SERIAL PRIMARY KEY,
    jogador_id INT REFERENCES jogadores(id) ON DELETE CASCADE,
    fase_alcancada INT DEFAULT 1,
    inimigos_mortos INT DEFAULT 0,
    sangue_ganho INT DEFAULT 0,
    xp_ganho INT DEFAULT 0,
    vitoria BOOLEAN DEFAULT FALSE,
    jogada_em TIMESTAMP DEFAULT NOW()
);
 
CREATE VIEW ranking AS
SELECT
    j.nome,
    ja.nivel,
    ja.total_xp,
    ja.pontos_sangue,
    COUNT(p.id) AS total_partidas,
    COALESCE(SUM(p.inimigos_mortos), 0) AS total_inimigos_mortos,
    COALESCE(SUM(CASE WHEN p.vitoria THEN 1 ELSE 0 END), 0) AS vitorias
FROM jogadores j
JOIN jogador_atributos ja ON j.id = ja.jogador_id
LEFT JOIN partidas p ON j.id = p.jogador_id
GROUP BY j.nome, ja.nivel, ja.total_xp, ja.pontos_sangue
ORDER BY ja.total_xp DESC;
 
