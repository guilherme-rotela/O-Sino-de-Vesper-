CREATE VIEW ranking AS
SELECT
    nome_usuario,
    nivel,
    xp,
    fase_atual,
    sangue,

    (
        (fase_atual * 1000) +
        (nivel * 100) +
        xp
    ) AS pontuacao

FROM jogadores

ORDER BY pontuacao DESC;



