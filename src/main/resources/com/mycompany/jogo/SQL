CREATE TABLE jogadores (
    id SERIAL PRIMARY KEY,
    nome_usuario VARCHAR(30) UNIQUE NOT NULL,

    nivel INT DEFAULT 1,
    xp INT DEFAULT 0,

    vida_max INT DEFAULT 100,
    vigor_max INT DEFAULT 100,

    sangue INT DEFAULT 0,

    vitalidade INT DEFAULT 1,
    vigor INT DEFAULT 1,
    tecnica INT DEFAULT 1,

    fase_atual INT DEFAULT 1,

);


CREATE TABLE status_personagem (
    id SERIAL PRIMARY KEY,

    jogador_id INT REFERENCES jogadores(id) ON DELETE CASCADE,

    vida_atual INT NOT NULL,
    vigor_atual INT NOT NULL,

    posicao_x FLOAT DEFAULT 0,
    posicao_y FLOAT DEFAULT 0,

    morto BOOLEAN DEFAULT FALSE

);

CREATE TABLE inimigos (
    id SERIAL PRIMARY KEY,

    nome VARCHAR(50) NOT NULL,

    tipo VARCHAR(30),

    vida INT,
    dano INT,
    velocidade FLOAT,

    sangue_drop INT,
    xp_drop INT
);

CREATE TABLE armas (
    id SERIAL PRIMARY KEY,

    nome VARCHAR(50),

    dano_base INT,
    escala_tecnica FLOAT,

    preco_arma INT DEFAULT 100
);

CREATE TABLE armaduras (
    id SERIAL PRIMARY KEY,

    nome VARCHAR(50),

    defesa INT,

    resistencia_sangue INT DEFAULT 0,

    preco_armadura INT DEFAULT 100
);

CREATE TABLE loja (
    id SERIAL PRIMARY KEY,

    item_nome VARCHAR(50),

    tipo_item VARCHAR(20),

    preco_sangue INT,

    descricao TEXT
);

CREATE TABLE fases (
    id SERIAL PRIMARY KEY,

    nome VARCHAR(50),

    dificuldade INT,

    boss_nome VARCHAR(50),

    recompensa_sangue INT
);

CREATE TABLE itens (
    id SERIAL PRIMARY KEY,

    nome VARCHAR(50) NOT NULL,

    tipo VARCHAR(20) NOT NULL,

    descricao TEXT,

    valor_sangue INT DEFAULT 0
);

CREATE TABLE inventario (
    id SERIAL PRIMARY KEY,

    jogador_id INT
        REFERENCES jogadores(id)
        ON DELETE CASCADE,

    item_id INT
        REFERENCES itens(id)
        ON DELETE CASCADE,

    quantidade INT DEFAULT 1,

    equipado BOOLEAN DEFAULT FALSE
);

CREATE TABLE equipamentos (
    id SERIAL PRIMARY KEY,

    jogador_id INT UNIQUE
        REFERENCES jogadores(id)
        ON DELETE CASCADE,

    arma_direita INT REFERENCES itens(id),

    armadura_peito INT REFERENCES itens(id)
);


