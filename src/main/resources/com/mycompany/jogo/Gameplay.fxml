<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.jogo.controller.GameplayController"
      styleClass="tela-fundo"
      prefWidth="800" prefHeight="600"
      spacing="0">

    <HBox styleClass="hud-painel" spacing="24" alignment="CENTER_LEFT">
        <VBox spacing="2" minWidth="160">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="❤ VIDA" styleClass="label-info"/>
                <Label fx:id="labelVida" text="100/100" styleClass="label-sangue"/>
            </HBox>
            <ProgressBar fx:id="barraVida" progress="1.0"
                         styleClass="barra-vida" prefWidth="160" prefHeight="10"/>
        </VBox>
        <VBox spacing="2" minWidth="160">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="◈ VIGOR" styleClass="label-info"/>
                <Label fx:id="labelVigor" text="100/100" styleClass="label-xp"/>
            </HBox>
            <ProgressBar fx:id="barraVigor" progress="1.0"
                         styleClass="barra-vigor" prefWidth="160" prefHeight="10"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER" spacing="2">
            <Label fx:id="labelFase" text="Fase 1 — Vila de Vesper" styleClass="label-fase"/>
            <Label fx:id="labelInimigos" text="Inimigos: 0/5" styleClass="label-info"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="2" alignment="CENTER_RIGHT">
            <Label fx:id="labelSangue" text="🩸 0" styleClass="label-sangue"/>
            <Label fx:id="labelXp"     text="✦ XP: 0" styleClass="label-xp"/>
        </VBox>
        <Button text="[ I ] Inventário" styleClass="btn-voltar" onAction="#onAbrirInventario"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <!-- Canvas: fundo, grade, barras de vida dos inimigos, efeitos -->
        <Canvas fx:id="canvasArena" width="800" height="490" styleClass="arena-gameplay"/>

        <!-- Pane transparente para os sprites PNG dos personagens -->
        <Pane fx:id="spritePane" mouseTransparent="true" prefWidth="800" prefHeight="490"/>

        <!-- Overlay de mensagem -->
        <VBox fx:id="painelMensagem" alignment="CENTER" spacing="10"
              visible="false" styleClass="tela-fundo">
            <Label fx:id="labelMensagem" text="" styleClass="label-titulo-tela"/>
            <Label fx:id="labelSubMensagem" text="" styleClass="label-info"/>
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="btnAcaoMensagem" text="Continuar"
                        styleClass="btn-acao" onAction="#onAcaoMensagem"/>
                <Button text="Menu" styleClass="btn-voltar" onAction="#onIrMenu"/>
            </HBox>
        </VBox>
    </StackPane>

    <HBox styleClass="hud-painel" spacing="30" alignment="CENTER">
        <Label text="WASD — Mover" styleClass="label-info"/>
        <Label text="J — Atacar" styleClass="label-info"/>
        <Label text="K — Esquivar" styleClass="label-info"/>
        <Label text="I — Inventário" styleClass="label-info"/>
    </HBox>

</VBox>