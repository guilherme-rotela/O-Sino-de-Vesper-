<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600" prefWidth="800" spacing="0" styleClass="tela-fundo" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.mycompany.jogo.controller.GameplayController">

    <!-- HUD Superior -->
    <HBox alignment="CENTER_LEFT" spacing="24" style="-fx-background-color: #8B0000;" styleClass="hud-painel">

        <!-- Vida -->
        <VBox minWidth="160" spacing="2">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label styleClass="label-info" text="❤ VIDA" textFill="WHITE" />
                <Label fx:id="labelVida" styleClass="label-sangue" text="100/100" textFill="WHITE" />
            </HBox>
            <ProgressBar fx:id="barraVida" prefHeight="10" prefWidth="160" progress="1.0" styleClass="barra-vida" />
        </VBox>

        <!-- Vigor -->
        <VBox minWidth="160" spacing="2">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label styleClass="label-info" text="◈ VIGOR" textFill="WHITE" />
                <Label fx:id="labelVigor" styleClass="label-xp" text="100/100" textFill="WHITE" />
            </HBox>
            <ProgressBar fx:id="barraVigor" prefHeight="10" prefWidth="160" progress="1.0" styleClass="barra-vigor" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Info central -->
        <VBox alignment="CENTER" spacing="2">
            <Label fx:id="labelFase" styleClass="label-fase" text="Fase 1 — Vila de Vesper" textFill="WHITE" />
            <Label fx:id="labelInimigos" styleClass="label-info" text="Inimigos: 0/5" textFill="WHITE" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Sangue e XP -->
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label fx:id="labelSangue" styleClass="label-sangue" text="🩸 0" textFill="WHITE" />
            <Label fx:id="labelXp" styleClass="label-xp" text="✦ XP: 0" textFill="WHITE" />
        </VBox>

        <!-- Botão inventário -->
        <Button onAction="" styleClass="btn-voltar" text="[ I ] Inventário" />

    </HBox>

    <!-- Arena de jogo (Canvas) -->
    <StackPane style="-fx-background-color: #131718;" VBox.vgrow="ALWAYS">
        <Canvas fx:id="canvasArena" height="490" styleClass="arena-gameplay" width="800" />
        <!-- Overlay de mensagem (wave clear, game over etc) -->
        <VBox fx:id="painelMensagem" alignment="CENTER" spacing="10" styleClass="tela-fundo" visible="false">
            <Label fx:id="labelMensagem" styleClass="label-titulo-tela" text="" />
            <Label fx:id="labelSubMensagem" styleClass="label-info" text="" />
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="btnAcaoMensagem" onAction="" styleClass="btn-acao" text="Continuar" />
                <Button onAction="" styleClass="btn-voltar" text="Menu" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- Controles hint -->
    <HBox alignment="CENTER" spacing="30" style="-fx-background-color: #63020c;" styleClass="hud-painel">
        <Label styleClass="label-info" text="WASD — Mover" textFill="#d78b8b" />
        <Label styleClass="label-info" text="J — Atacar" textFill="#d78b8b" />
        <Label styleClass="label-info" text="K — Esquivar" textFill="#d78b8b" />
        <Label styleClass="label-info" text="I — Inventário" textFill="#d78b8b" />
    </HBox>

</VBox>
