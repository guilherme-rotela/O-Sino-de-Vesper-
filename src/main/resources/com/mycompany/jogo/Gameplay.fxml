<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.jogo.controller.GameplayController"
      styleClass="tela-fundo"
      prefWidth="1920" prefHeight="1080"
      spacing="0">

    <HBox styleClass="hud-painel" spacing="32" alignment="CENTER_LEFT" minHeight="64">

        <VBox spacing="4" minWidth="200">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="❤  VIDA" styleClass="hud-label-titulo"/>
                <Label fx:id="labelVida" text="100/100" styleClass="hud-label-valor-vida"/>
            </HBox>
            <ProgressBar fx:id="barraVida" progress="1.0"
                         styleClass="barra-vida" prefWidth="200" prefHeight="14"/>
        </VBox>

        <VBox spacing="4" minWidth="200">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="◈  VIGOR" styleClass="hud-label-titulo"/>
                <Label fx:id="labelVigor" text="100/100" styleClass="hud-label-valor-vigor"/>
            </HBox>
            <ProgressBar fx:id="barraVigor" progress="1.0"
                         styleClass="barra-vigor" prefWidth="200" prefHeight="14"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox alignment="CENTER" spacing="4">
            <Label fx:id="labelFase" text="Fase 1 — Vila de Vesper" styleClass="hud-label-fase"/>
            <Label fx:id="labelInimigos" text="Inimigos: 0/5" styleClass="hud-label-inimigos"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label fx:id="labelSangue" text="🩸 0" styleClass="hud-label-sangue"/>
            <Label fx:id="labelXp"     text="✦ XP: 0" styleClass="hud-label-xp"/>
        </VBox>

        <Button text="[ I ] Inventário" styleClass="btn-hud" onAction="#onAbrirInventario"/>
        <Button text="Menu" styleClass="btn-hud-perigo" onAction="#onIrMenu"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <Canvas fx:id="canvasArena" styleClass="arena-gameplay"/>
        <Pane fx:id="spritePane" mouseTransparent="true"/>

        <VBox fx:id="painelMensagem" alignment="CENTER" spacing="20"
              visible="false" styleClass="painel-mensagem">
            <Label fx:id="labelMensagem"    text="" styleClass="msg-titulo"/>
            <Label fx:id="labelSubMensagem" text="" styleClass="msg-sub"
                   wrapText="true" textAlignment="CENTER"/>
            <HBox alignment="CENTER" spacing="16">
                <Button fx:id="btnAcaoMensagem" text="Continuar"
                        styleClass="btn-acao" onAction="#onAcaoMensagem"/>
                <Button text="Menu" styleClass="btn-voltar" onAction="#onIrMenu"/>
            </HBox>
        </VBox>
    </StackPane>

    <HBox styleClass="hud-rodape" spacing="40" alignment="CENTER" minHeight="36">
        <Label text="WASD  Mover"   styleClass="hud-controle"/>
        <Label text="J  Atacar"      styleClass="hud-controle"/>
        <Label text="K  Esquivar"    styleClass="hud-controle"/>
        <Label text="I  Inventário"  styleClass="hud-controle"/>
        <Label text="ESC  Sair"      styleClass="hud-controle"/>
    </HBox>

</VBox>