<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.jogo.controller.NomeJogadorController"
      styleClass="tela-fundo"
      alignment="CENTER"
      spacing="20"
      prefWidth="800" prefHeight="600">

    <padding><Insets top="80" bottom="80" left="160" right="160"/></padding>

    <Label text="QUEM ÉS TU, CAÇADOR?" styleClass="label-titulo-tela"/>

    <Label text="Informe seu nome para entrar em Vesper:" styleClass="label-info"/>

    <TextField fx:id="campoNome"
               styleClass="campo-texto"
               promptText="Nome do caçador..."
               onAction="#onConfirmar"/>

    <Label fx:id="labelErro" styleClass="label-sangue" text="" visible="false"/>

    <HBox alignment="CENTER" spacing="16">
        <Button text="ENTRAR EM VESPER" styleClass="btn-acao" onAction="#onConfirmar"/>
        <Button text="Voltar" styleClass="btn-voltar" onAction="#onVoltar"/>
    </HBox>

    <Label text="Se já jogou antes, seu progresso será carregado automaticamente."
           styleClass="label-info" wrapText="true" textAlignment="CENTER"/>

</VBox>