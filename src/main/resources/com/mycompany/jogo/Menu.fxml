<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox alignment="CENTER"
      prefWidth="1920" prefHeight="1080"
      spacing="0"
      styleClass="tela-fundo"
      xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.jogo.controller.MenuController">

    <Region VBox.vgrow="ALWAYS"/>

    <Label text="O Sino de Vesper"
           styleClass="label-titulo-tela"
           style="-fx-font-size: 52px;"/>

    <Label text="· · · · ·"
           style="-fx-text-fill: #4a3f6b; -fx-font-size: 22px;">
        <VBox.margin><Insets top="8" bottom="40"/></VBox.margin>
    </Label>

    <Button onAction="#gameplay" text="JOGAR"
            prefWidth="240" prefHeight="46" styleClass="btn-acao">
        <VBox.margin><Insets top="6" bottom="6"/></VBox.margin>
    </Button>

    <Button onAction="#ranking" text="RANKING"
            prefWidth="240" prefHeight="46" styleClass="btn-voltar">
        <VBox.margin><Insets top="6" bottom="6"/></VBox.margin>
    </Button>

    <Button onAction="#creditos" text="CRÉDITOS"
            prefWidth="240" prefHeight="46" styleClass="btn-voltar">
        <VBox.margin><Insets top="6" bottom="6"/></VBox.margin>
    </Button>

    <Region prefHeight="20"/>

    <Button onAction="#encerrar" text="ENCERRAR"
            prefWidth="240" prefHeight="46" styleClass="btn-hud-perigo">
        <VBox.margin><Insets top="6" bottom="6"/></VBox.margin>
    </Button>

    <Region VBox.vgrow="ALWAYS"/>

    <Label text="ESC para sair a qualquer momento"
           style="-fx-text-fill: #3a2a2a; -fx-font-size: 11px; -fx-font-family: Monospace;">
        <VBox.margin><Insets bottom="20"/></VBox.margin>
    </Label>

</VBox>